// SIDE D: Skills routine. Add the skills run here when ready.
void auton_skills(void) {

}

void autonomous(void) {
    if (autonStrategy == SIDED) {
        auton_skills();
        return;
    }
    switch (startPos) {
        case RED_LEFT:
            if (autonStrategy == SIDEA)      auton_red_left();
            else if (autonStrategy == SIDEB) auton_red_left_alt();
            else                             auton_red_left_sideC();
            break;
        case RED_BOTTOM:
            if (autonStrategy == SIDEA)      auton_red_bottom();
            else if (autonStrategy == SIDEB) auton_red_bottom_alt();
            else                             auton_red_bottom_sideC();
            break;
        case BLUE_RIGHT:
            if (autonStrategy == SIDEA)      auton_blue_right();
            else if (autonStrategy == SIDEB) auton_blue_right_alt();
            else                             auton_blue_right_sideC();
            break;
        case BLUE_TOP:
            if (autonStrategy == SIDEA)      auton_blue_top();
            else if (autonStrategy == SIDEB) auton_blue_top_alt();
            else                             auton_blue_top_sideC();
            break;
    }
}

// ============================================================
// COMPETITION CALLBACKS
// ============================================================
const char* startPosLabel(StartPosition pos) {
    switch (pos) {
        case RED_LEFT:   return "RED LEFT";
        case RED_BOTTOM: return "RED BOTTOM";
        case BLUE_RIGHT: return "BLUE RIGHT";
        case BLUE_TOP:   return "BLUE TOP";
        default:         return "UNKNOWN";
    }
}

const char* autonStrategyLabel(AutonStrategy strat) {
    switch (strat) {
        case SIDEA: return "SIDE A";
        case SIDEB: return "SIDE B";
        case SIDEC: return "SIDE C";
        case SIDED: return "SIDE D - SKILLS";
        default:    return "UNKNOWN";
    }
}

// ============================================================
// AUTON SELECTOR (Brain touchscreen)
// ============================================================
// Pick everything on the Brain screen instead of re-flashing.
// Flow: SIDE? -> COLOR? -> POSITION?

struct SelectorButton {
    int x, y, w, h;
    const char* label;
    color buttonColor;
};

void drawSelectorButton(const SelectorButton& b) {
    Brain.Screen.setFillColor(color(28, 28, 28));
    Brain.Screen.setPenColor(b.buttonColor);
    Brain.Screen.drawRectangle(b.x, b.y, b.w, b.h);
    Brain.Screen.printAt(b.x + 10, b.y + b.h / 2 + 5, b.label);
}

// Blocks until a NEW touch lands inside a button, then returns its index.
int waitForButtonPress(SelectorButton* buttons, int count) {
    // Wait for release first so one long touch can't skip pages.
    while (Brain.Screen.pressing()) this_thread::sleep_for(20);
    this_thread::sleep_for(100);

    while (true) {
        if (Brain.Screen.pressing()) {
            int tx = Brain.Screen.xPosition();
            int ty = Brain.Screen.yPosition();
            for (int i = 0; i < count; i++) {
                SelectorButton& b = buttons[i];
                if (tx >= b.x && tx <= b.x + b.w && ty >= b.y && ty <= b.y + b.h) {
                    while (Brain.Screen.pressing()) this_thread::sleep_for(20);
                    this_thread::sleep_for(100);
                    return i;
                }
            }
            // Touch missed all buttons; wait for release.
            while (Brain.Screen.pressing()) this_thread::sleep_for(20);
        }
        this_thread::sleep_for(20);
    }
}

void run_auton_selector(void) {
    // Ignore stray touches at power-on: wait for ~200ms of "not pressed".
    int stableNotPressedCount = 0;
    while (stableNotPressedCount < 10) {
        if (!Brain.Screen.pressing()) stableNotPressedCount++;
        else stableNotPressedCount = 0;
        this_thread::sleep_for(20);
    }

    // ---- Step 1: SIDE? ----
    Brain.Screen.clearScreen();
    Brain.Screen.printAt(140, 20, "SIDE?");
    SelectorButton sideButtons[] = {
        {20,  40, 120, 70, "SIDE A", color::blue},
        {160, 40, 120, 70, "SIDE B", color::purple},
        {300, 40, 120, 70, "SIDE C", color::green},
        {160, 125, 120, 70, "SIDE D", color::yellow}
    };
    for (int i = 0; i < 4; i++) drawSelectorButton(sideButtons[i]);
    int sideChoice = waitForButtonPress(sideButtons, 4);
    autonStrategy = (sideChoice == 0) ? SIDEA : (sideChoice == 1) ? SIDEB : (sideChoice == 2) ? SIDEC : SIDED;

    // ---- Step 2: COLOR? ----
    Brain.Screen.clearScreen();
    Brain.Screen.printAt(140, 20, "COLOR?");
    SelectorButton colorButtons[] = {
        {40,  40, 150, 80, "RED", color::red},
        {230, 40, 150, 80, "BLUE", color::blue}
    };
    for (int i = 0; i < 2; i++) drawSelectorButton(colorButtons[i]);
    int colorChoice = waitForButtonPress(colorButtons, 2);
    bool isRed = (colorChoice == 0);

    // ---- Step 3: POSITION? ----
    Brain.Screen.clearScreen();
    Brain.Screen.printAt(110, 20, "POSITION?");
    if (isRed) {
        SelectorButton posButtons[] = {
            {40,  40, 150, 80, "LEFT", color::white},
            {230, 40, 150, 80, "BOTTOM", color::white}
        };
        for (int i = 0; i < 2; i++) drawSelectorButton(posButtons[i]);
        int posChoice = waitForButtonPress(posButtons, 2);
        startPos = (posChoice == 0) ? RED_LEFT : RED_BOTTOM;
    } else {
        SelectorButton posButtons[] = {
            {40,  40, 150, 80, "RIGHT", color::white},
            {230, 40, 150, 80, "TOP", color::white}
        };
        for (int i = 0; i < 2; i++) drawSelectorButton(posButtons[i]);
        int posChoice = waitForButtonPress(posButtons, 2);
        startPos = (posChoice == 0) ? BLUE_RIGHT : BLUE_TOP;
    }

    // ---- Brief confirmation ----
    Brain.Screen.clearScreen();
    Brain.Screen.printAt(30, 40, "SELECTED:");
    Brain.Screen.printAt(30, 70, false, "%s", startPosLabel(startPos));
    Brain.Screen.printAt(30, 100, false, "%s", autonStrategyLabel(autonStrategy));
    this_thread::sleep_for(1000);
}

// Prints text one character at a time (typewriter effect).
void typeOutLine(int row, const char* text, int char_delay_ms = 40) {
    char buffer[64];
    int len = 0;
    while (text[len] != '\0' && len < 63) len++;

    for (int i = 0; i < len; i++) {
        buffer[i] = text[i];
        buffer[i + 1] = '\0';
        Brain.Screen.setCursor(row, 1);
        Brain.Screen.print("%s", buffer);
        this_thread::sleep_for(char_delay_ms);
    }
}

void pre_auton(void) {
    // Skills configuration: always start at RED LEFT; no selector is shown.
    startPos = RED_LEFT;
    autonStrategy = SIDED;

    Brain.Screen.clearScreen();

    char sideLine[32];
    sprintf(sideLine, "AUTO: SKILLS");
    typeOutLine(4, sideLine);

    char posLine[32];
    sprintf(posLine, "START: RED LEFT");
    typeOutLine(5, posLine);

    // Set odometry to the selected start pose (does not start driving).
    double start_x, start_y, start_heading_deg;
    get_start_pose(startPos, start_x, start_y, start_heading_deg);
    odom_init(start_x, start_y, start_heading_deg * (M_PI / 180.0));
    odom_initialized = true;

    this_thread::sleep_for(1000);
    Brain.Screen.clearScreen();
    Brain.Screen.printAt(20, 25, "START COORDINATES");

    char xLine[64];
    sprintf(xLine, "X: %.2f in", start_x);
    typeOutLine(3, xLine, 35);

    char yLine[64];
    sprintf(yLine, "Y: %.2f in", start_y);
    typeOutLine(4, yLine, 35);

    char headingLine[64];
    sprintf(headingLine, "HEADING: %.1f deg", start_heading_deg);
    typeOutLine(5, headingLine, 35);
}


void usercontrol(void) {
    while (true) {
        // DRIVE: Axis3 = forward/back; Axis1 = turn.
        double forwardInput = apply_dead_zone(Con.Axis3.position(percentUnits::pct));
        double turnInput = apply_dead_zone(Con.Axis1.position(percentUnits::pct));

        double leftCommand = clampd(forwardInput + turnInput, -100.0, 100.0);
        double rightCommand = clampd(forwardInput - turnInput, -100.0, 100.0);
        LS.spin(directionType::fwd, leftCommand, velocityUnits::pct);
        RS.spin(directionType::fwd, rightCommand, velocityUnits::pct);

        // INTAKE: hold R2 = forward, hold L2 = reverse, else stop.
        bool r2IntakePressed = Con.ButtonR2.pressing();
        bool l2Pressed = Con.ButtonL2.pressing();
        if (r2IntakePressed && !l2Pressed) {
            Intake.spin(directionType::fwd, 100, velocityUnits::pct);
        } else if (l2Pressed && !r2IntakePressed) {
            Intake.spin(directionType::rev, 100, velocityUnits::pct);
        } else {
            Intake.stop(brakeType::coast);
        }

        // LIFT
        if (Con.ButtonR2.pressing()) {
            LiftL.spin(directionType::fwd, 100, velocityUnits::pct);
            LiftR.spin(directionType::rev, 100, velocityUnits::pct);
        }
        else if (Con.ButtonL2.pressing()) {
            LiftL.spin(directionType::rev, 100, velocityUnits::pct);
            LiftR.spin(directionType::fwd, 100, velocityUnits::pct);
        }
        else {
            Lift.stop(brakeType::hold);
        }
    }
}
int main() {
    Competition.autonomous(autonomous);
    Competition.drivercontrol(usercontrol);

    pre_auton();
    vex::task odomTaskHandle(odom_task);
    vex::task liftTaskHandle(lift_task);
    vex::task displayTaskHandle(display_task);

    while (true) {
        this_thread::sleep_for(100);
    }
}
